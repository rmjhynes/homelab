---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: applications
  namespace: argocd
spec:
  project: homelab
  source:
    repoURL: https://github.com/rmjhynes/homelab.git
    targetRevision: ${target_revision}
    path: applications
    # Child apps template their targetRevision from this value. Without it,
    # child apps hardcode HEAD (main) and any sync reverts a branch under test.
    helm:
      parameters:
        - name: targetRevision
          value: "${target_revision}"
  destination:
    # Resources applied to default k3s cluster
    name: in-cluster
    namespace: argocd
  syncPolicy:
    automated:
      # ArgoCD removes these default fields from the live spec, which would show
      # as drift to Terraform
      # prune: false
      # allowEmpty: false
      selfHeal: true
